// The camera, in place of Windows' Camera app: the options in the top bar (device, Photo or Video, timer, mirror, grid),
// the live preview in the middle with the shutter and the last capture's thumbnail on the right, and the resolution and
// save folder in the status bar. With no camera, the preview shows "No camera found" and a Check again button.
import { ComboBox } from "std-widgets.slint";
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Icons as SharedIcons } from "@rimelight_ui/icons.slint";
import { Icons } from "icons.slint";
import { StatusBar, ToolButton } from "widgets.slint";
import { Slider } from "@rimelight_ui/components/slider.slint";
import { Button, ButtonVariant } from "@rimelight_ui/components/button.slint";
import { TooltipPlacement } from "@rimelight_ui/components/tooltip.slint";
import { ToolDivider, ToolbarRow } from "@rimelight_ui/components/toolbar.slint";
import { Camera, Shell } from "state.slint";

export component CameraPage inherits Rectangle {
    background: Tokens.surface-base;

    // The timer presets, in seconds (cameractl.rs TIMER_SECS): the index is what the page stores.
    property <[int]> timer-secs: [0, 3, 5, 10];
    // The shutter is 80 px; the thumbnail is 60% of it, so both sit on one centred column.
    property <length> shutter-size: 80px;
    property <length> thumb-size: 48px;

    VerticalLayout {
        // Options: the device, the mode, the delay, the mirror and the grid.
        ToolbarRow {
            ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: Icons.camera; label: "Camera"; tooltip: "Camera"; clicked => { } }
            ComboBox {
                model: Camera.devices;
                current-index: Camera.device-index;
                width: 240px;
                enabled: Camera.devices.length > 0 && !Camera.recording;
                selected(value) => { Camera.set-device(self.current-index); }
            }
            ToolDivider { }
            ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: Icons.camera; label: "Photo"; tooltip: "Photo"; enabled: !Camera.recording; selected: !Camera.video-mode; ghost-toggle: true; clicked => { Camera.set-video(false); } }
            ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: SharedIcons.video; label: "Video"; tooltip: "Video"; enabled: !Camera.recording; selected: Camera.video-mode; ghost-toggle: true; clicked => { Camera.set-video(true); } }
            ToolDivider { }
            // The delay: a slider over the four presets (it snaps to the nearest one), then the preset buttons.
            HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: start;
                horizontal-stretch: 0;
                opacity: !Camera.video-mode && Camera.countdown == 0 ? 1 : 0.4;
                Text { text: "Delay"; color: Tokens.text-muted; font-size: Type.body.size; vertical-alignment: center; }
                Slider {
                    on-stage: false;
                    controlled: true;
                    minimum: 0;
                    maximum: 1;
                    step: 0;
                    width: 120px;
                    value: Camera.timer-index / 3;
                    changed(v) => {
                        if !Camera.video-mode && Camera.countdown == 0 { Camera.set-timer(round(v * 3)); }
                    }
                    released(v) => {
                        if !Camera.video-mode && Camera.countdown == 0 { Camera.set-timer(round(v * 3)); }
                    }
                }
                for secs[i] in timer-secs: Button {
                    text: secs == 0 ? "0 s" : secs + " s";
                    variant: Camera.timer-index == i ? ButtonVariant.secondary : ButtonVariant.ghost;
                    enabled: !Camera.video-mode && Camera.countdown == 0;
                    clicked => { Camera.set-timer(i); }
                }
            }
            ToolDivider { }
            ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: SharedIcons.flip-horizontal-2; label: "Mirror"; tooltip: "Mirror"; selected: Camera.mirror; ghost-toggle: true; clicked => { Camera.set-mirror(!Camera.mirror); } }
            ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: Icons.grid; label: "Grid"; tooltip: "Grid"; selected: Camera.grid; ghost-toggle: true; clicked => { Camera.set-grid(!Camera.grid); } }
            Rectangle { horizontal-stretch: 1; }
            if Shell.recording: ToolDivider { }
            if Shell.recording: ToolButton { tooltip-placement: TooltipPlacement.bottom; icon: Icons.stop; label: "Stop recording"; tooltip: "Stop recording"; clicked => { Shell.stop-recording(); } }
        }

        // The preview, and the shutter with the thumbnail on the right.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: Tokens.space-4;
            spacing: Tokens.space-4;

            Rectangle {
                horizontal-stretch: 1;
                background: #000000;
                border-radius: Tokens.radius-r8;
                clip: true;

                if Camera.has-frame: Image {
                    width: 100%;
                    height: 100%;
                    source: Camera.frame;
                    image-fit: contain;
                }

                // Rule-of-thirds grid over the whole preview.
                if Camera.grid && Camera.has-frame: Rectangle {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { y: parent.height / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                    Rectangle { y: parent.height * 2 / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                }

                // No camera: a centred message with Check again.
                if Camera.devices.length == 0: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: Tokens.space-3;
                    Text {
                        text: "No camera found";
                        color: Tokens.extension-media-text-on-stage;
                        font-size: Type.heading.size;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button { text: "Check again"; variant: ButtonVariant.secondary; clicked => { Camera.check-again(); } }
                    }
                }

                // A camera that is not showing a picture yet: its status, or the hint to pick one.
                if Camera.devices.length > 0 && !Camera.has-frame: Text {
                    text: Camera.status != "" ? Camera.status : (Camera.running ? "Starting the camera..." : "Choose a camera");
                    color: Tokens.extension-media-text-on-stage;
                    font-size: Type.heading.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // The photo timer's count.
                if Camera.countdown > 0: Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 70px;
                    background: #00000090;
                    Text {
                        text: Camera.countdown-text;
                        color: #FFFFFF;
                        font-size: 72px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Video time, with a red dot while recording.
                if Camera.recording: Rectangle {
                    x: Tokens.space-3;
                    y: Tokens.space-3;
                    width: rec-row.preferred-width + Tokens.space-4;
                    height: 32px;
                    border-radius: Tokens.radius-control;
                    background: #000000A0;
                    rec-row := HorizontalLayout {
                        padding-left: Tokens.space-3;
                        padding-right: Tokens.space-3;
                        spacing: Tokens.space-2;
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.extension-media-record; }
                        }
                        Text { text: Camera.time-text; color: #FFFFFF; font-size: Type.body.size; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }

            // One column: the shutter, then the thumbnail, both centred on the same vertical axis.
            VerticalLayout {
                width: 120px;
                spacing: Tokens.space-5;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.shutter-size;
                        height: root.shutter-size;
                        border-radius: root.shutter-size / 2;
                        border-width: 4px;
                        border-color: #FFFFFF;
                        background: shutter-ta.has-hover ? #FFFFFF26 : transparent;
                        Rectangle {
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            x: 8px;
                            y: 8px;
                            border-radius: self.width / 2;
                            background: Camera.video-mode ? Tokens.extension-media-record : #FFFFFF;
                            Image {
                                visible: Camera.recording;
                                source: Icons.stop;
                                width: 30px;
                                height: 30px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: #FFFFFF;
                            }
                        }
                        shutter-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Camera.shutter(); }
                        }
                    }
                }

                // The last capture: a click opens it.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.thumb-size;
                        height: root.thumb-size;
                        border-radius: Tokens.radius-control;
                        clip: true;
                        background: Tokens.surface-sunken;
                        border-width: 1px;
                        border-color: Tokens.border-subtle;
                        if Camera.has-thumb: Image {
                            width: 100%;
                            height: 100%;
                            source: Camera.thumb;
                            image-fit: cover;
                        }
                        if !Camera.has-thumb: Image {
                            width: Tokens.icon-medium;
                            height: Tokens.icon-medium;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: SharedIcons.image;
                            colorize: Tokens.text-muted;
                        }
                        thumb-ta := TouchArea {
                            enabled: Camera.has-thumb;
                            mouse-cursor: pointer;
                            clicked => { Camera.open-last(); }
                        }
                    }
                }
            }
        }

        // Left: the resolution and the save folder. Right: the recording time while recording.
        StatusBar {
            left-text: Camera.resolution != "" ? Camera.resolution + " | " + Camera.save-folder : Camera.save-folder;
            if Camera.recording: Text {
                text: "● " + Camera.time-text;
                color: Tokens.extension-media-record;
                font-size: Type.caption.size;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
