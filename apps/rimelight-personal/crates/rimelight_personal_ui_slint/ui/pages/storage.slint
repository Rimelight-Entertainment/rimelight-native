// The Storage route: the feature's StoragePage fed by StorageState, which the Rust glue (src/pages/storage.rs) fills.
import { StoragePage, StorageFolderRow, StorageCrumb, StorageFolderCard, StorageFileRow, StorageInspector } from "@rimelight_personal_feature_storage/storage.slint";
import { SelectOption } from "@rimelight_ui/components/select.slint";

export { StorageFolderRow, StorageCrumb, StorageFolderCard, StorageFileRow, StorageInspector } from "@rimelight_personal_feature_storage/storage.slint";

export global StorageState {
    in-out property <[StorageFolderRow]> folders;
    in-out property <int> root-count;
    in-out property <bool> root-selected;
    in-out property <[StorageCrumb]> crumbs;
    in-out property <[StorageFolderCard]> subfolders;
    in-out property <[StorageFileRow]> files;
    in-out property <bool> table-view;
    in-out property <int> filter;
    in-out property <int> selected-count;
    in-out property <bool> all-visible-selected;
    in-out property <bool> loading;
    in-out property <bool> uploading;
    in-out property <string> error;
    in-out property <bool> folder-empty;
    in-out property <bool> new-folder-open;
    in-out property <StorageInspector> inspector;
    in-out property <string> confirm-message;
    in-out property <string> query;
    in-out property <string> new-folder-name;

    callback refresh-requested();
    callback open-folder-requested(string);
    callback query-changed(string);
    callback filter-requested(int);
    callback table-requested(bool);
    callback toggle-select-requested(string);
    callback select-visible-requested(bool);
    callback new-folder-requested();
    callback new-folder-name-changed(string);
    callback create-folder-requested();
    callback close-new-folder-requested();
    callback upload-requested();
    callback open-detail-requested(string);
    callback close-detail-requested();
    callback detail-basename-changed(string);
    callback detail-folder-changed(string);
    callback save-detail-requested();
    callback copy-requested(string);
    callback delete-requested(string);
    callback delete-selected-requested();
    callback confirm-delete-requested();
    callback cancel-delete-requested();
    callback dismiss-error-requested();
    callback move-requested(string, string);
    callback toggle-audio-requested(string);
    callback previews-visible-requested([string]);
}

export component StorageRoute inherits Rectangle {
    StoragePage {
        folders: StorageState.folders;
        root-count: StorageState.root-count;
        root-selected: StorageState.root-selected;
        crumbs: StorageState.crumbs;
        subfolders: StorageState.subfolders;
        files: StorageState.files;
        table-view: StorageState.table-view;
        filter: StorageState.filter;
        selected-count: StorageState.selected-count;
        all-visible-selected: StorageState.all-visible-selected;
        loading: StorageState.loading;
        uploading: StorageState.uploading;
        error: StorageState.error;
        folder-empty: StorageState.folder-empty;
        new-folder-open: StorageState.new-folder-open;
        inspector: StorageState.inspector;
        confirm-message: StorageState.confirm-message;
        query <=> StorageState.query;
        new-folder-name <=> StorageState.new-folder-name;

        refresh-requested() => { StorageState.refresh-requested(); }
        open-folder-requested(p) => { StorageState.open-folder-requested(p); }
        query-changed(q) => { StorageState.query-changed(q); }
        filter-requested(i) => { StorageState.filter-requested(i); }
        table-requested(on) => { StorageState.table-requested(on); }
        toggle-select-requested(id) => { StorageState.toggle-select-requested(id); }
        select-visible-requested(on) => { StorageState.select-visible-requested(on); }
        new-folder-requested() => { StorageState.new-folder-requested(); }
        new-folder-name-changed(n) => { StorageState.new-folder-name-changed(n); }
        create-folder-requested() => { StorageState.create-folder-requested(); }
        close-new-folder-requested() => { StorageState.close-new-folder-requested(); }
        upload-requested() => { StorageState.upload-requested(); }
        open-detail-requested(id) => { StorageState.open-detail-requested(id); }
        close-detail-requested() => { StorageState.close-detail-requested(); }
        detail-basename-changed(t) => { StorageState.detail-basename-changed(t); }
        detail-folder-changed(f) => { StorageState.detail-folder-changed(f); }
        save-detail-requested() => { StorageState.save-detail-requested(); }
        copy-requested(key) => { StorageState.copy-requested(key); }
        delete-requested(id) => { StorageState.delete-requested(id); }
        delete-selected-requested() => { StorageState.delete-selected-requested(); }
        confirm-delete-requested() => { StorageState.confirm-delete-requested(); }
        cancel-delete-requested() => { StorageState.cancel-delete-requested(); }
        dismiss-error-requested() => { StorageState.dismiss-error-requested(); }
        move-requested(id, dest) => { StorageState.move-requested(id, dest); }
        toggle-audio-requested(id) => { StorageState.toggle-audio-requested(id); }
        previews-visible-requested(ids) => { StorageState.previews-visible-requested(ids); }
    }
}
