// Rimelight Media's own brand images. The Lucide icons are in @rimelight_ui/icons.slint (Icons).
export global Brand {
    out property <image> logo: @image-url("../assets/logo/logo_color.svg");
    // The app's own icon (the .exe and shortcut icon), as a PNG exported from assets/logo/logo_color.ico.
    out property <image> app-icon: @image-url("../assets/logo/logo_color.png");
}
