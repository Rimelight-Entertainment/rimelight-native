// The Lucide icons the shell draws (ui/icons, copied from lucide-static 0.460.0, ISC licence). Each icon is an alpha mask,
// so the Image that shows it sets `colorize` to tint it. `icon-for` maps a nav icon name (crates/idantity_nav) to its image.
export global NavIcons {
    out property <image> layout-dashboard: @image-url("icons/layout-dashboard.svg");
    out property <image> inbox: @image-url("icons/inbox.svg");
    out property <image> notebook-pen: @image-url("icons/notebook-pen.svg");
    out property <image> sticky-note: @image-url("icons/sticky-note.svg");
    out property <image> notebook: @image-url("icons/notebook.svg");
    out property <image> square-check-big: @image-url("icons/square-check-big.svg");
    out property <image> circle-check: @image-url("icons/circle-check.svg");
    out property <image> wallet: @image-url("icons/wallet.svg");
    out property <image> receipt: @image-url("icons/receipt.svg");
    out property <image> landmark: @image-url("icons/landmark.svg");
    out property <image> arrow-down-left: @image-url("icons/arrow-down-left.svg");
    out property <image> credit-card: @image-url("icons/credit-card.svg");
    out property <image> chart-pie: @image-url("icons/chart-pie.svg");
    out property <image> scale: @image-url("icons/scale.svg");
    out property <image> gift: @image-url("icons/gift.svg");
    out property <image> house: @image-url("icons/house.svg");
    out property <image> heart: @image-url("icons/heart.svg");
    out property <image> shopping-cart: @image-url("icons/shopping-cart.svg");
    out property <image> sparkles: @image-url("icons/sparkles.svg");
    out property <image> activity: @image-url("icons/activity.svg");
    out property <image> timer: @image-url("icons/timer.svg");
    out property <image> dumbbell: @image-url("icons/dumbbell.svg");
    out property <image> music: @image-url("icons/music.svg");
    out property <image> music-2: @image-url("icons/music-2.svg");
    out property <image> disc: @image-url("icons/disc.svg");
    out property <image> radio: @image-url("icons/radio.svg");
    out property <image> film: @image-url("icons/film.svg");
    out property <image> tv: @image-url("icons/tv.svg");
    out property <image> book-open: @image-url("icons/book-open.svg");
    out property <image> folder-open: @image-url("icons/folder-open.svg");
    out property <image> log-out: @image-url("icons/log-out.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> panel-left: @image-url("icons/panel-left.svg");
    out property <image> sun: @image-url("icons/sun.svg");
    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> monitor: @image-url("icons/monitor.svg");

    public pure function icon-for(name: string) -> image {
        if (name == "layout-dashboard") { return layout-dashboard; }
        if (name == "inbox") { return inbox; }
        if (name == "notebook-pen") { return notebook-pen; }
        if (name == "sticky-note") { return sticky-note; }
        if (name == "notebook") { return notebook; }
        if (name == "square-check-big") { return square-check-big; }
        if (name == "circle-check") { return circle-check; }
        if (name == "wallet") { return wallet; }
        if (name == "receipt") { return receipt; }
        if (name == "landmark") { return landmark; }
        if (name == "arrow-down-left") { return arrow-down-left; }
        if (name == "credit-card") { return credit-card; }
        if (name == "chart-pie") { return chart-pie; }
        if (name == "scale") { return scale; }
        if (name == "gift") { return gift; }
        if (name == "house") { return house; }
        if (name == "heart") { return heart; }
        if (name == "shopping-cart") { return shopping-cart; }
        if (name == "sparkles") { return sparkles; }
        if (name == "activity") { return activity; }
        if (name == "timer") { return timer; }
        if (name == "dumbbell") { return dumbbell; }
        if (name == "music") { return music; }
        if (name == "music-2") { return music-2; }
        if (name == "disc") { return disc; }
        if (name == "radio") { return radio; }
        if (name == "film") { return film; }
        if (name == "tv") { return tv; }
        if (name == "book-open") { return book-open; }
        if (name == "folder-open") { return folder-open; }
        return layout-dashboard;
    }
}
