// The Notebooks route. The feature page (NotebooksPage) owns the markup; this file mirrors its properties and callbacks in
// the NotebooksState global, so Rust reaches them as ui.global::<NotebooksState>().
import { NotebooksPage, NotebookEntryRow } from "@rimelight_personal_feature_notebooks/notebooks.slint";
import { PageLoadState } from "@rimelight_ui/components/page-state.slint";
import { TableColumn, TableRow } from "@rimelight_ui/components/table.slint";

export { NotebookEntryRow } from "@rimelight_personal_feature_notebooks/notebooks.slint";

export global NotebooksState {
    in property <PageLoadState> state;
    in property <string> error;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <[string]> tab-labels;
    in property <int> tab;
    in-out property <string> search-text;
    in property <string> thread-id;
    in property <bool> thread-open;
    in-out property <string> thread-title;
    in property <[NotebookEntryRow]> entries;
    in property <bool> entries-loading;
    in property <string> thread-count;
    in-out property <string> thread-draft;
    in property <bool> thread-adding;
    in-out property <string> edit-text;
    in property <bool> thread-pinned;
    in property <bool> thread-archived;
    in property <bool> thread-trashed;
    in property <bool> create-open;
    in-out property <string> create-title;
    in-out property <string> create-content;
    in property <bool> creating;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-action;

    callback opened();
    callback retry-requested();
    callback tab-requested(int);
    callback search-requested(string);
    callback new-requested();
    callback row-picked(int);
    callback row-action-requested(int, string);
    callback dismiss-error-requested();
    callback create-requested();
    callback create-cancel-requested();
    callback thread-closed();
    callback thread-rename-requested(string);
    callback thread-draft-add-requested(string);
    callback start-edit-requested(string);
    callback edit-cancel-requested();
    callback edit-save-requested(string);
    callback delete-entry-requested(string);
    callback thread-pin-requested();
    callback thread-archive-requested();
    callback thread-trash-requested();
    callback thread-restore-requested();
    callback thread-delete-requested();
    callback confirm-accept-requested();
    callback confirm-cancel-requested();
}

export component NotebooksRoute inherits VerticalLayout {
    NotebooksPage {
        state: NotebooksState.state;
        error: NotebooksState.error;
        columns: NotebooksState.columns;
        rows: NotebooksState.rows;
        tab-labels: NotebooksState.tab-labels;
        tab: NotebooksState.tab;
        search-text <=> NotebooksState.search-text;
        thread-id: NotebooksState.thread-id;
        thread-open: NotebooksState.thread-open;
        thread-title <=> NotebooksState.thread-title;
        entries: NotebooksState.entries;
        entries-loading: NotebooksState.entries-loading;
        thread-count: NotebooksState.thread-count;
        thread-draft <=> NotebooksState.thread-draft;
        thread-adding: NotebooksState.thread-adding;
        edit-text <=> NotebooksState.edit-text;
        thread-pinned: NotebooksState.thread-pinned;
        thread-archived: NotebooksState.thread-archived;
        thread-trashed: NotebooksState.thread-trashed;
        create-open: NotebooksState.create-open;
        create-title <=> NotebooksState.create-title;
        create-content <=> NotebooksState.create-content;
        creating: NotebooksState.creating;
        confirm-title: NotebooksState.confirm-title;
        confirm-message: NotebooksState.confirm-message;
        confirm-action: NotebooksState.confirm-action;

        opened => { NotebooksState.opened(); }
        retry-requested => { NotebooksState.retry-requested(); }
        tab-requested(index) => { NotebooksState.tab-requested(index); }
        search-requested(text) => { NotebooksState.search-requested(text); }
        new-requested => { NotebooksState.new-requested(); }
        row-picked(index) => { NotebooksState.row-picked(index); }
        row-action-requested(index, id) => { NotebooksState.row-action-requested(index, id); }
        dismiss-error-requested => { NotebooksState.dismiss-error-requested(); }
        create-requested => { NotebooksState.create-requested(); }
        create-cancel-requested => { NotebooksState.create-cancel-requested(); }
        thread-closed => { NotebooksState.thread-closed(); }
        thread-rename-requested(text) => { NotebooksState.thread-rename-requested(text); }
        thread-draft-add-requested(text) => { NotebooksState.thread-draft-add-requested(text); }
        start-edit-requested(id) => { NotebooksState.start-edit-requested(id); }
        edit-cancel-requested => { NotebooksState.edit-cancel-requested(); }
        edit-save-requested(text) => { NotebooksState.edit-save-requested(text); }
        delete-entry-requested(id) => { NotebooksState.delete-entry-requested(id); }
        thread-pin-requested => { NotebooksState.thread-pin-requested(); }
        thread-archive-requested => { NotebooksState.thread-archive-requested(); }
        thread-trash-requested => { NotebooksState.thread-trash-requested(); }
        thread-restore-requested => { NotebooksState.thread-restore-requested(); }
        thread-delete-requested => { NotebooksState.thread-delete-requested(); }
        confirm-accept-requested => { NotebooksState.confirm-accept-requested(); }
        confirm-cancel-requested => { NotebooksState.confirm-cancel-requested(); }
    }
}
