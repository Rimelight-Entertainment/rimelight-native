/shots/
/publish/
/releases/
/dist/
**/dist/
/ffmpeg-work/
/target-bench/
/target-check/
.data/

# ── Android / Gradle ──────────────────────────────────────────────────────────
.gradle/
local.properties
**/local.properties
*.iml
apps/android/app/src/main/jniLibs/
**/android/app/build/
**/android/build/
**/android/.gradle/
**/jniLibs/
*.apk
*.aab

# ── Apple ─────────────────────────────────────────────────────────────────────
apps/ios/build/
DerivedData/
*.xcuserstate

# ── Web ───────────────────────────────────────────────────────────────────────
node_modules/
apps/web/dist/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
.dev.vars
**/.dev.vars
!**/.dev.vars.example
*.pem
*.key

