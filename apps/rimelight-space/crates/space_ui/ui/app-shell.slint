// App shell (S9.4, SF.4): the window apps/desktop opens. Rail and sidebar (from space_nav), a top bar, the page area
// (a placeholder per route, or a shell screen: About, Report Issue or Settings), the command palette (Ctrl+K), the toast stack and the status bar at the
// bottom. The Rust side (src/slint_ui/app_shell.rs) fills every model and answers every callback; this markup only draws
// and reports input.
//
// Tab row (desktop): the top-level row above the top bar. Left to right: the sidebar collapse button, Back, Forward, the
// workspace tabs and the "+" button. The three controls sit on a surface-raised block, like the top bar.
// Top bar (SF.4, IA owner direction 1): a surface-raised strip across the content column. Right, left to right: the search input (opens the command palette), the
// notifications button, and the avatar. The avatar opens the profile menu (presence picker, Profile, About, Report Issue, Settings, Sign out); the
// presence is local UI state held here. Every top bar control is centred vertically in the bar.
//
// Draw order. The top bar is drawn after the page area, so its tooltips and popovers draw over the tab strip and the page.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Rail, RailItem, RailBadge } from "@rimelight_shell/components/rail.slint";
import { Sidebar, SidebarItem, ProjectChoice, SidebarSize } from "@rimelight_shell/components/sidebar.slint";
import { CommandPalette, PaletteRow } from "@rimelight_shell/components/command-palette.slint";
import { StatusBar, JobItem } from "@rimelight_shell/components/status-bar.slint";
import { TabBar } from "@rimelight_shell/components/tab-bar.slint";
import { MoreDrawer } from "@rimelight_shell/components/more-drawer.slint";
import { ToastStack, ToastEntry } from "@rimelight_ui/components/toast.slint";
import { ClipboardWriter } from "@rimelight_ui/components/clipboard-writer.slint";
import { EmptyState } from "@rimelight_ui/components/empty-state.slint";
import { TabStrip, TabItem } from "@rimelight_ui/components/tabs.slint";
import { ContextMenu, MenuItem } from "@rimelight_ui/components/menu.slint";
import { Breadcrumbs } from "@rimelight_ui/components/breadcrumbs.slint";
import { AboutScreen } from "@rimelight_shell/about.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { IconButton } from "@rimelight_ui/components/icon-button.slint";
import { Button, ButtonVariant, ButtonSize } from "@rimelight_ui/components/button.slint";
import { Avatar, AvatarSize } from "@rimelight_ui/components/avatar.slint";
import { Popover } from "@rimelight_ui/components/popover.slint";
import { SearchField } from "@rimelight_ui/components/search-field.slint";
import { AccountMenu, PresenceMark, UserPresence } from "@rimelight_shell/components/account-menu.slint";
import { Tooltip, TooltipBounds, TooltipHub, TooltipPlacement, TooltipOverlay } from "@rimelight_ui/components/tooltip.slint";
import { QuickAction, QuickCategory } from "@rimelight_shell/components/quick-action.slint";
import { InputFocus } from "@rimelight_ui/components/input-focus.slint";
import { ConnectionState } from "@rimelight_shell/components/connection-state.slint";
import { Spinner, SpinnerSize } from "@rimelight_ui/components/spinner.slint";
import { SignInScreen, SessionPhase } from "@rimelight_shell/components/sign-in-screen.slint";
