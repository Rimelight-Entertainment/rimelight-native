// The Inbox route: the feature's InboxPage fed by InboxState, which the Rust glue (src/pages/inbox.rs) fills.
import { InboxPage, InboxMailbox, InboxFolder, InboxChoice, InboxListRow, InboxLine, InboxAttachment, InboxMessage, InboxHeader } from "@rimelight_personal_feature_inbox/inbox.slint";

export { InboxMailbox, InboxFolder, InboxChoice, InboxListRow, InboxLine, InboxAttachment, InboxMessage, InboxHeader } from "@rimelight_personal_feature_inbox/inbox.slint";

export global InboxState {
    in-out property <bool> loading;
    in-out property <string> banner;
    in-out property <[InboxMailbox]> mailboxes;
    in-out property <[InboxFolder]> folders;
    in-out property <[InboxChoice]> move-targets;
    in-out property <string> folder;
    in-out property <string> search;
    in-out property <[InboxListRow]> list;
    in-out property <bool> list-loading;
    in-out property <string> list-error;
    in-out property <int> page: 1;
    in-out property <int> pages: 1;
    in-out property <int> total: 0;
    in-out property <string> thread-key;
    in-out property <[InboxMessage]> thread;
    in-out property <bool> thread-loading;
    in-out property <string> thread-error;
    in-out property <bool> compose-open;
    in-out property <string> compose-title;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <bool> compose-show-cc-bcc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in-out property <string> compose-status;
    in-out property <string> compose-error;
    in-out property <bool> compose-sending;
    in-out property <[string]> compose-attachments;
    in-out property <bool> settings-open;
    in-out property <bool> settings-loading;
    in-out property <string> settings-from-name;
    in-out property <string> settings-signature;
    in-out property <bool> settings-signature-enabled;
    in-out property <bool> settings-saving;
    in-out property <string> settings-error;
    in-out property <bool> create-open;
    in-out property <string> create-prefix;
    in-out property <string> create-domain;
    in-out property <[string]> create-domains;
    in-out property <string> create-name;
    in-out property <bool> create-creating;
    in-out property <string> create-error;
    in-out property <bool> folder-form-open;
    in-out property <bool> folder-form-rename;
    in-out property <string> folder-form-name;
    in-out property <string> folder-form-error;
    in-out property <bool> confirm-open;
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;
    in-out property <bool> headers-open;
    in-out property <[InboxHeader]> headers;
    in-out property <int> viewer-kind: -1;
    in-out property <string> viewer-title;
    in-out property <string> viewer-text;
    in-out property <string> viewer-path;
    in-out property <image> viewer-picture;
    in-out property <string> move-menu-id;
    in-out property <bool> media-playing;
    in-out property <int> media-position-ms;
    in-out property <int> media-duration-ms;
    in-out property <float> media-volume: 1;

    callback banner-dismissed();
    callback mailbox-requested(string);
    callback folder-requested(string);
    callback search-requested(string);
    callback page-requested(int);
    callback thread-requested(string);
    callback thread-closed();
    callback star-requested(string, bool);
    callback read-requested(string, bool);
    callback move-requested(string, string);
    callback headers-requested(string);
    callback headers-closed();
    callback header-copy-requested(int);
    callback original-requested(string);
    callback attachment-requested(string, string);
    callback new-message-requested();
    callback reply-requested(string, bool);
    callback forward-requested(string);
    callback draft-requested(string);
    callback discard-draft-requested(string);
    callback compose-field-changed(int, string);
    callback compose-cc-toggled();
    callback compose-markup-requested(string);
    callback compose-attach-requested();
    callback compose-attachment-removed(int);
    callback compose-sent();
    callback compose-closed();
    callback settings-open-requested();
    callback settings-closed();
    callback settings-field-changed(int, string);
    callback settings-signature-toggled(bool);
    callback settings-saved();
    callback create-open-requested();
    callback create-closed();
    callback create-field-changed(int, string);
    callback create-domain-requested(int);
    callback create-submitted();
    callback folder-create-requested();
    callback folder-rename-requested(string);
    callback folder-delete-requested(string);
    callback folder-form-closed();
    callback folder-name-changed(string);
    callback folder-submitted();
    callback mailbox-delete-requested();
    callback confirm-yes-requested();
    callback confirm-no-requested();
    callback viewer-closed();
    callback media-toggle-requested();
    callback media-seek-requested(int);
    callback media-volume-requested(float);
}

export component InboxRoute inherits Rectangle {
    InboxPage {
        loading: InboxState.loading;
        banner: InboxState.banner;
        mailboxes: InboxState.mailboxes;
        folders: InboxState.folders;
        move-targets: InboxState.move-targets;
        folder: InboxState.folder;
        search <=> InboxState.search;
        list: InboxState.list;
        list-loading: InboxState.list-loading;
        list-error: InboxState.list-error;
        page <=> InboxState.page;
        pages: InboxState.pages;
        total: InboxState.total;
        thread-key: InboxState.thread-key;
        thread: InboxState.thread;
        thread-loading: InboxState.thread-loading;
        thread-error: InboxState.thread-error;
        compose-open: InboxState.compose-open;
        compose-title: InboxState.compose-title;
        compose-to: InboxState.compose-to;
        compose-cc: InboxState.compose-cc;
        compose-bcc: InboxState.compose-bcc;
        compose-show-cc-bcc: InboxState.compose-show-cc-bcc;
        compose-subject: InboxState.compose-subject;
        compose-body: InboxState.compose-body;
        compose-status: InboxState.compose-status;
        compose-error: InboxState.compose-error;
        compose-sending: InboxState.compose-sending;
        compose-attachments: InboxState.compose-attachments;
        settings-open: InboxState.settings-open;
        settings-loading: InboxState.settings-loading;
        settings-from-name: InboxState.settings-from-name;
        settings-signature: InboxState.settings-signature;
        settings-signature-enabled: InboxState.settings-signature-enabled;
        settings-saving: InboxState.settings-saving;
        settings-error: InboxState.settings-error;
        create-open: InboxState.create-open;
        create-prefix: InboxState.create-prefix;
        create-domain: InboxState.create-domain;
        create-domains: InboxState.create-domains;
        create-name: InboxState.create-name;
        create-creating: InboxState.create-creating;
        create-error: InboxState.create-error;
        folder-form-open: InboxState.folder-form-open;
        folder-form-rename: InboxState.folder-form-rename;
        folder-form-name: InboxState.folder-form-name;
        folder-form-error: InboxState.folder-form-error;
        confirm-open: InboxState.confirm-open;
        confirm-title: InboxState.confirm-title;
        confirm-message: InboxState.confirm-message;
        headers-open: InboxState.headers-open;
        headers: InboxState.headers;
        viewer-kind: InboxState.viewer-kind;
        viewer-title: InboxState.viewer-title;
        viewer-text: InboxState.viewer-text;
        viewer-path: InboxState.viewer-path;
        viewer-picture: InboxState.viewer-picture;
        move-menu-id <=> InboxState.move-menu-id;
        media-playing: InboxState.media-playing;
        media-position-ms: InboxState.media-position-ms;
        media-duration-ms: InboxState.media-duration-ms;
        media-volume: InboxState.media-volume;

        banner-dismissed() => { InboxState.banner-dismissed(); }
        mailbox-requested(id) => { InboxState.mailbox-requested(id); }
        folder-requested(id) => { InboxState.folder-requested(id); }
        search-requested(q) => { InboxState.search-requested(q); }
        page-requested(p) => { InboxState.page-requested(p); }
        thread-requested(key) => { InboxState.thread-requested(key); }
        thread-closed() => { InboxState.thread-closed(); }
        star-requested(id, on) => { InboxState.star-requested(id, on); }
        read-requested(id, on) => { InboxState.read-requested(id, on); }
        move-requested(id, folder) => { InboxState.move-requested(id, folder); }
        headers-requested(id) => { InboxState.headers-requested(id); }
        headers-closed() => { InboxState.headers-closed(); }
        header-copy-requested(i) => { InboxState.header-copy-requested(i); }
        original-requested(id) => { InboxState.original-requested(id); }
        attachment-requested(email, att) => { InboxState.attachment-requested(email, att); }
        new-message-requested() => { InboxState.new-message-requested(); }
        reply-requested(id, all) => { InboxState.reply-requested(id, all); }
        forward-requested(id) => { InboxState.forward-requested(id); }
        draft-requested(id) => { InboxState.draft-requested(id); }
        discard-draft-requested(id) => { InboxState.discard-draft-requested(id); }
        compose-field-changed(f, t) => { InboxState.compose-field-changed(f, t); }
        compose-cc-toggled() => { InboxState.compose-cc-toggled(); }
        compose-markup-requested(kind) => { InboxState.compose-markup-requested(kind); }
        compose-attach-requested() => { InboxState.compose-attach-requested(); }
        compose-attachment-removed(i) => { InboxState.compose-attachment-removed(i); }
        compose-sent() => { InboxState.compose-sent(); }
        compose-closed() => { InboxState.compose-closed(); }
        settings-open-requested() => { InboxState.settings-open-requested(); }
        settings-closed() => { InboxState.settings-closed(); }
        settings-field-changed(f, t) => { InboxState.settings-field-changed(f, t); }
        settings-signature-toggled(on) => { InboxState.settings-signature-toggled(on); }
        settings-saved() => { InboxState.settings-saved(); }
        create-open-requested() => { InboxState.create-open-requested(); }
        create-closed() => { InboxState.create-closed(); }
        create-field-changed(f, t) => { InboxState.create-field-changed(f, t); }
        create-domain-requested(i) => { InboxState.create-domain-requested(i); }
        create-submitted() => { InboxState.create-submitted(); }
        folder-create-requested() => { InboxState.folder-create-requested(); }
        folder-rename-requested(id) => { InboxState.folder-rename-requested(id); }
        folder-delete-requested(id) => { InboxState.folder-delete-requested(id); }
        folder-form-closed() => { InboxState.folder-form-closed(); }
        folder-name-changed(t) => { InboxState.folder-name-changed(t); }
        folder-submitted() => { InboxState.folder-submitted(); }
        mailbox-delete-requested() => { InboxState.mailbox-delete-requested(); }
        confirm-yes-requested() => { InboxState.confirm-yes-requested(); }
        confirm-no-requested() => { InboxState.confirm-no-requested(); }
        viewer-closed() => { InboxState.viewer-closed(); }
        media-toggle-requested() => { InboxState.media-toggle-requested(); }
        media-seek-requested(ms) => { InboxState.media-seek-requested(ms); }
        media-volume-requested(v) => { InboxState.media-volume-requested(v); }
    }
}
