// A tile group (planned feature B, tiles; `PROJECT.md section 6.6` "Tile groups"): its rectangle in the page area, its own
// page tab strip (`tabs`, `active`, `pinned-count`) and the icon of its active page. Rust fills the list with
// `TileLayout::layout_rects` (src/slint_ui/tiles.rs). `focused` is true for the focused group.
export struct TileGroup {
    id: int,
    x: float,
    y: float,
    w: float,
    h: float,
    focused: bool,
    icon: image,
    tabs: [TabItem],
    active: int,
    pinned-count: int,
    // The group's own page header (its active page): the title, the crumbs, and the header's controls.
    title: string,
    route: string,
    crumbs: [string],
    can-share: bool,
    inspector-available: bool,
}

// A bar between the two children of a split. `vertical-bar` is true for a side-by-side split (the bar runs down).
export struct TileHandle {
    x: float,
    y: float,
    w: float,
    h: float,
    vertical-bar: bool,
}

// One row of the workspace sheet (planned feature B3b): the name (a tap switches), a pin mark for a pinned workspace, a check
// on the active one, an X that closes it (not drawn for a pinned workspace), and a "more" button that opens the workspace
// menu (D12: Rename, Pin, Duplicate, Close; the sheet's own menu, see `workspace-sheet-menu-requested`).
component WorkspaceSwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> name;
    in property <bool> pinned;
    in property <bool> active;
    callback activated();
    callback closed();
    // The "more" button's left edge and bottom edge, in window coordinates (the menu opens below it).
    callback more-requested(float, float);

    height: Tokens.size-control-lg;
    border-radius: Tokens.radius-r4;
    background: active ? Tokens.surface-raised : transparent;

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-2;
        alignment: stretch;

        Rectangle {
            horizontal-stretch: 1;

            Text {
                x: 0px;
                width: parent.width;
                height: parent.height;
                text: root.name;
                color: Tokens.text-primary;
                font-family: Type.body.family;
                font-size: Type.body.size;
                font-weight: root.active ? Type.heading.weight : Type.body.weight;
                vertical-alignment: center;
                overflow: elide;
            }

            // Drawn last, so the whole name area is the tap target.
            TouchArea {
                x: 0px;
                width: parent.width;
                height: parent.height;
                accessible-role: button;
                accessible-label: root.label;
                clicked => { root.activated(); }
            }
        }

        if root.pinned : Image {
            width: Icons.small-size;
            height: Icons.small-size;
            y: (parent.height - self.height) / 2;
            source: Icons.pin;
            colorize: Tokens.text-muted;
        }

        if root.active : Image {
            width: Icons.small-size;
            height: Icons.small-size;
            y: (parent.height - self.height) / 2;
            source: Icons.check;
            colorize: Tokens.text-primary;
        }

        more := IconButton {
            icon: Icons.ellipsis;
            label: "More actions for \{root.label}";
            tooltip: "More";
            variant: ButtonVariant.ghost;
            size: ButtonSize.sm;
            clicked => { root.more-requested(more.absolute-position.x / 1px, (more.absolute-position.y + more.height) / 1px); }
        }

        if !root.pinned : IconButton {
            icon: Icons.x;
            label: "Close \{root.label}";
            tooltip: "Close";
            variant: ButtonVariant.ghost;
            size: ButtonSize.sm;
            clicked => { root.closed(); }
        }
    }
}

export component AppShell inherits Window {
    title: "Rimelight Space";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 480px;
    background: Tokens.surface-base;
    // Ctrl+K is read by `keys` when no control has focus. Focus moves to the palette while it is open.
    forward-focus: keys;

    // Rail and sidebar. `shell-area` is the active area (rail index); `sidebar-selected` the highlighted sidebar row.
    in property <[RailItem]> rail-items;
    // Work-queue badges (OQ3), one per area in rail order. Empty by default, so no area shows a badge.
    in property <[RailBadge]> rail-badges;
    in-out property <int> shell-area: 0;
    in property <[SidebarItem]> sidebar-rows;
    in property <string> sidebar-title;
    in property <image> sidebar-icon;
    // The project switcher (tail C3): on the Projects area the sidebar header is the switcher, over `project-choices` (the list
    // the shell narrows by the filter), with `project-key` the current project.
    in property <bool> sidebar-switcher: false;
    in property <[ProjectChoice]> project-choices;
    in property <string> project-key;
    // The current project's picture (empty when it has none), drawn in the switcher's trigger.
    in property <image> project-image;
    in property <bool> project-has-image: false;
    // The current project's initials, drawn in the switcher's trigger when it has no picture.
    in property <string> project-initials;
    callback project-filter-changed(string);
    callback project-picked(string);
    callback project-create-requested();
    in-out property <int> sidebar-selected: -1;
    // Desktop only: true when the user has collapsed the sidebar. The tab row's collapse button then reads "Show sidebar".
    in-out property <bool> sidebar-collapsed: false;

    // Phone layout (PLAN 6.2): below the breakpoint the rail, sidebar and status bar give way to the bottom tab bar
    // (`tab-items`, the last one is More) and a drawer that lists the active area's sidebar rows.
    // Set from width changes (not bound to it), so the layouts that read `phone` do not form a binding loop with the window size.
    out property <bool> phone: false;
    init => {
        root.phone = root.width < Tokens.size-phone-breakpoint;
        TooltipBounds.width = root.width;
        TooltipBounds.height = root.height;
    }
    changed width => {
        root.phone = root.width < Tokens.size-phone-breakpoint;
        TooltipBounds.width = root.width;
    }
    changed height => { TooltipBounds.height = root.height; }
    in property <[RailItem]> tab-items;
    in-out property <int> tab-selected: -1;
    in-out property <bool> drawer-open: false;
    // Phone More drawer (OQ24, OQ29): true while the More panel shows instead of the active area's tree.
    in-out property <bool> more-view: false;
    in property <[RailItem]> more-areas;

    // The page placeholder: title, route, description and the area icon.
    in property <string> page-title;
    in property <string> page-route;
    in property <image> page-icon;
    in property <string> empty-title: "Wireframe coming in a later step";
    in property <string> empty-description: "This page is a placeholder. The real content and data come with its phase.";

    // Company > Employees (SP.3b): its data, set by crates/areas/company/src/employees.rs. Its events come back as the callbacks below.
    in-out property <PageLoadState> employees-state: PageLoadState.loading;
    in-out property <string> employees-error;
    in-out property <bool> employees-has-more;
    in-out property <bool> employees-loading-more;
    callback employees-opened();
    callback employees-search(string);
    callback employees-open(string);
    callback employees-load-more();
    callback employees-retry();

    // Projects > Issues (S1.3): the issue list of one project, set by src/pages/projects/issues.rs. Its events come back as the
    // callbacks below. The query text is two-way with the page's query bar.
    in-out property <PageLoadState> issues-state: PageLoadState.loading;
    in-out property <string> issues-error;
    in-out property <[IssueRow]> issues-rows;
    in-out property <bool> issues-has-more;
    in-out property <bool> issues-loading-more;
    in-out property <string> issues-query;
    in-out property <[bool]> issues-chip-on;
    in-out property <string> issues-sort-field;
    in-out property <bool> issues-sort-desc;
    in-out property <string> issues-query-message;
    in-out property <string> issues-query-before;
    in-out property <string> issues-query-span;
    in-out property <string> issues-query-after;
    in-out property <bool> issues-can-create;
    // True for a tab route that is a project's issue list (`/p/:key/issues`). Answered by Rust.
    pure callback is-issues-route(string) -> bool;
    callback issues-opened(string);
    callback issues-retry();
    callback issues-search(string);
    callback issues-submit(string);
    callback issues-chip(int);
    callback issues-sort(string);
    callback issues-load-more();
    callback issues-open-issue(string);
    // Opens a route in the page tab (the issue opened from a row or a create).
    callback issues-open(string);
    // The issues page's view (0 table, 1 board), and the board's columns, names and move error (set by issues.rs).
    in-out property <int> issues-view-mode: 0;
    in-out property <[BoardLane]> issues-board;
    in-out property <string> issues-board-error;
    callback issues-board-move(string, int);
    // The board column under a pointer x (the drop target of a card drag), answered by Rust: see issues.rs.
    callback issues-column-at(float, float, float, int) -> int;
    callback issues-view-changed(int);
    // Projects > Overview (/p/:key): the project summary (ui/pages/projects/overview.slint), set by src/pages/projects/overview.rs.
    in-out property <PageLoadState> overview-state: PageLoadState.loading;
    in-out property <string> overview-error;
    in-out property <string> overview-project-name;
    in-out property <string> overview-project-key;
    in-out property <string> overview-description;
    in-out property <string> overview-owner;
    in-out property <string> overview-members;
    in-out property <string> overview-total;
    in-out property <string> overview-open;
    in-out property <string> overview-closed;
    in-out property <bool> overview-truncated;
    in-out property <[OverviewCountRow]> overview-states;
    in-out property <[OverviewCountRow]> overview-priorities;
    in-out property <[IssueRow]> overview-recent;
    in-out property <bool> overview-sprint-present;
    in-out property <string> overview-sprint-name;
    in-out property <string> overview-sprint-dates;
    in-out property <string> overview-sprint-goal;
    in-out property <string> overview-sprint-counts;
    in-out property <[OverviewAreaRow]> overview-areas;
    pure callback is-overview-route(string) -> bool;
    callback overview-opened(string);
    callback overview-retry();
    callback overview-open-issue(string);
    // New issue dialog (S1.5c, ui/pages/projects/new-issue.slint). Opened by the issues page's New issue button and by the
    // quick action's New issue entry: `new-issue-requested` is answered by src/pages/projects/new_issue.rs (it fills the
    // form, then asks for the dialog with `new-issue-show`). The form values are two-way with the dialog's fields.
    // Create project dialog (pages/projects/create-project.slint), opened by the switcher's Create New Project row.
    // src/slint_ui/app_shell.rs fills and shows it; its Save runs the create and closes it on success.
    in-out property <bool> create-project-show: false;
    in-out property <string> create-project-key;
    in-out property <string> create-project-name;
    in-out property <string> create-project-description;
    in-out property <string> create-project-error;
    in-out property <bool> create-project-creating: false;
    in property <bool> create-project-picture-supported: false;
    in property <string> create-project-picture-name;
    in property <image> create-project-picture-preview;
    in property <bool> create-project-picture-has-preview: false;
    callback create-project-save(string, string, string);
    callback create-project-cancel();
    callback create-project-choose-picture();
    callback new-issue-requested();
    callback new-issue-show();
    callback new-issue-close();
    in-out property <[SelectOption]> new-issue-project-options;
    in-out property <string> new-issue-project;
    in-out property <string> new-issue-summary;
    in-out property <string> new-issue-description;
    in-out property <[SelectOption]> new-issue-type-options;
    in-out property <string> new-issue-type: "Task";
    in-out property <[SelectOption]> new-issue-state-options;
    in-out property <string> new-issue-state;
    in-out property <[SelectOption]> new-issue-priority-options;
    in-out property <string> new-issue-priority: "Normal";
    in-out property <[SelectOption]> new-issue-assignee-options;
    in-out property <string> new-issue-assignee;
    in-out property <[SelectOption]> new-issue-sprint-options;
    in-out property <string> new-issue-sprint;
    in-out property <string> new-issue-due-date;
    in-out property <string> new-issue-tags;
    in-out property <[MultiOption]> new-issue-area-options;
    in-out property <string> new-issue-area-summary;
    in-out property <string> new-issue-area-query;
    in-out property <[CalendarDay]> new-issue-due-days;
    in-out property <[string]> new-issue-weekday-labels;
    in-out property <string> new-issue-due-title;
    callback new-issue-due-picked(int);
    callback new-issue-due-month-step(int);
    callback new-issue-area-toggled(string);
    // New sprint (src/pages/projects/new_sprint.rs): the dialog's form, its date grids, and its callbacks.
    in-out property <string> new-sprint-name;
    in-out property <string> new-sprint-goal;
    in-out property <string> new-sprint-start-date;
    in-out property <string> new-sprint-end-date;
    in-out property <[CalendarDay]> new-sprint-start-days;
    in-out property <[CalendarDay]> new-sprint-end-days;
    in-out property <string> new-sprint-start-title;
    in-out property <string> new-sprint-end-title;
    in-out property <[string]> new-sprint-weekday-labels;
    in-out property <bool> new-sprint-creating;
    in-out property <string> new-sprint-error;
    callback new-sprint-requested();
    callback new-sprint-show();
    callback new-sprint-close();
    callback new-sprint-create();
    callback new-sprint-start-picked(int);
    callback new-sprint-start-step(int);
    callback new-sprint-end-picked(int);
    callback new-sprint-end-step(int);
    in-out property <[string]> new-issue-files;
    in-out property <bool> new-issue-can-create;
    in-out property <bool> new-issue-creating;
    in-out property <string> new-issue-error;
    in property <bool> new-issue-edit-mode;
    in-out property <string> new-issue-estimate;
    out property <bool> new-issue-is-open: new-issue.is-open;
    callback new-issue-project-picked(string);
    callback new-issue-summary-edited();
    callback new-issue-attach();
    callback new-issue-remove-file(int);
    callback new-issue-create();
    // Projects > Issue (S1.3, part 3): one issue at `/p/:key/issues/:id`, set by src/pages/projects/issue.rs. Its events come back
    // as the callbacks below.
    in-out property <PageLoadState> issue-state: PageLoadState.loading;
    in-out property <string> issue-error;
    in-out property <IssueDetailView> issue-view;
    in-out property <bool> issue-saving;
    in-out property <string> issue-action-error;
    in-out property <[IssueRef]> issue-subtasks;
    in-out property <[LinkRow]> issue-links;
    in-out property <[CommentRow]> issue-comments;
    in-out property <[string]> issue-activity;
    in-out property <bool> issue-can-edit;
    in-out property <bool> issue-can-moderate;
    in-out property <bool> issue-can-delete;
    in-out property <bool> issue-confirm-delete;
    in-out property <string> issue-comment-edit-draft;
    in-out property <[WorkRow]> issue-work;
