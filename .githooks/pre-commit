#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1

# Only check when Rust, Slint or Cargo files are staged.
git diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '\.(rs|slint)$|(^|/)(Cargo\.toml|Cargo\.lock|rust-toolchain\.toml)$|^\.cargo/config\.toml$' \
  || exit 0

echo "pre-commit: cargo fmt --all -- --check"
cargo fmt --all -- --check || { echo "pre-commit: run cargo fmt --all, then recommit" >&2; exit 1; }

echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings || { echo "pre-commit: fix clippy warnings, then recommit" >&2; exit 1; }