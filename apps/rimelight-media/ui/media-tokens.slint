// Media-only sizes with no shared equivalent. Every colour, space, radius, type and motion value comes from
// @rimelight_design/tokens.slint (Tokens) and @rimelight_ui/typography.slint (Type); the stage, record and file-type
// colours are the shared extension-* tokens.
export global MediaTokens {
    // The large icon in Media's panels is 28 px; the shared icon-large is 24 px.
    out property <length> icon-large: 28px;
}
