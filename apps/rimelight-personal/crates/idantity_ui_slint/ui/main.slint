// The idantity app shell (crate idantity_ui_slint). build.rs compiles this file. The Rust side (src/shell.rs) fills the
// sidebar from idantity_nav and switches the page on `route`. Each route's page lives in ui/pages/<page>.slint and is
// wired by src/pages/<page>.rs (crates/features/README.md, "Wiring into idantity_ui_slint").

import { Tokens, ThemeChoice } from "@rimelight_design/tokens.slint";
import { Sidebar, SidebarItem, SidebarKind, SidebarStatus, SidebarLeading } from "@rimelight_shell/components/sidebar.slint";
import { CommandPalette, PaletteRow } from "@rimelight_shell/components/command-palette.slint";
import { ClipboardWriter } from "@rimelight_ui/components/clipboard-writer.slint";
import { ToastStack, ToastEntry, ToastTone } from "@rimelight_ui/components/toast.slint";
import { Popover } from "@rimelight_ui/components/popover.slint";
import { ShortcutsDialog } from "@rimelight_shell/components/shortcuts-dialog.slint";
import { QuickTodoModal } from "@idantity_feature_todos/todos.slint";
import { Button, ButtonVariant, ButtonSize } from "@rimelight_ui/components/button.slint";
import { SelectOption } from "@rimelight_ui/components/select.slint";
import { TableColumn, TableRow } from "@rimelight_ui/components/table.slint";
import { PageLoadState } from "@rimelight_ui/components/page-state.slint";
import { CalendarDay } from "@rimelight_ui/components/calendar-grid.slint";
import { ChartPoint } from "@rimelight_ui/components/chart.slint";
import { BoardLane, BoardItem } from "@rimelight_shell/templates/board-page.slint";

import { SignInScreen, SessionPhase } from "@rimelight_shell/components/sign-in-screen.slint";
import { ConnectionState } from "@rimelight_shell/components/connection-state.slint";
import { Spinner, SpinnerSize } from "@rimelight_ui/components/spinner.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Session } from "sign-in.slint";
import { TodosRoute, TodosState, TodoRow, TodoTab } from "pages/todos.slint";
import { NotesRoute, NotesState, NoteCard } from "pages/notes.slint";
import { HabitsRoute, HabitsState, HabitYearTab, HabitDay, HabitWeek, HabitRow, HabitCategoryRow } from "pages/habits.slint";
import { WatchlistRoute, WatchlistState, WatchlistCategory, WatchlistColumn } from "pages/watchlist.slint";
import { FocusState, FocusRoute, FocusMode } from "pages/focus.slint";
import { OverviewRoute, OverviewState, OverviewTask, OverviewNote } from "pages/overview.slint";
import { ProjectsRoute, ProjectsState, ProjectBoardTab } from "pages/projects.slint";
import { FinancesRoute, FinancesState, FinanceStat, FinanceRow, FinanceSection, FinanceChip, FinanceField } from "pages/finances.slint";
import { HousingRoute, HousingState, HousingStat, HousingRow, HousingSection, HousingChip, HousingField } from "pages/housing.slint";
import { HealthRoute, HealthState, HealthSetRow, HealthExerciseRow, HealthExerciseDay, HealthStretchRow, HealthRoutine, HealthStageRow, HealthHistoryBar, HealthMetricRow } from "pages/health.slint";
import { InboxRoute, InboxState, InboxMailbox, InboxFolder, InboxChoice, InboxListRow, InboxLine, InboxAttachment, InboxMessage, InboxHeader } from "pages/inbox.slint";
import { StorageRoute, StorageState, StorageFolderRow, StorageCrumb, StorageFolderCard, StorageFileRow, StorageInspector } from "pages/storage.slint";
import { MusicState, MusicRoute } from "pages/music.slint";
import { NotebooksState, NotebooksRoute } from "pages/notebooks.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { ScrollView } from "std-widgets.slint";
export { Icons } from "@rimelight_ui/icons.slint";

// Re-exports for the Rust side (crate::generated). Every type the glue names must be listed here.
export { Tokens, ThemeChoice } from "@rimelight_design/tokens.slint";
export { SidebarItem, SidebarKind, SidebarStatus, SidebarLeading } from "@rimelight_shell/components/sidebar.slint";
export { PaletteRow } from "@rimelight_shell/components/command-palette.slint";
export { ToastEntry, ToastTone } from "@rimelight_ui/components/toast.slint";
export { SelectOption } from "@rimelight_ui/components/select.slint";
export { TableColumn, TableRow } from "@rimelight_ui/components/table.slint";
export { PageLoadState } from "@rimelight_ui/components/page-state.slint";
export { CalendarDay } from "@rimelight_ui/components/calendar-grid.slint";
export { ChartPoint } from "@rimelight_ui/components/chart.slint";
export { BoardLane, BoardItem } from "@rimelight_shell/templates/board-page.slint";
export { Session } from "sign-in.slint";
export { SessionPhase } from "@rimelight_shell/components/sign-in-screen.slint";
export { ConnectionState } from "@rimelight_shell/components/connection-state.slint";
export { TodosState, TodoRow, TodoTab } from "pages/todos.slint";
export { NotesState, NoteCard } from "pages/notes.slint";
export { HabitsState, HabitYearTab, HabitDay, HabitWeek, HabitRow, HabitCategoryRow } from "pages/habits.slint";
export { WatchlistState, WatchlistCategory, WatchlistColumn } from "pages/watchlist.slint";
export { FocusState, FocusMode } from "pages/focus.slint";
export { OverviewState, OverviewTask, OverviewNote } from "pages/overview.slint";
export { ProjectsState, ProjectBoardTab } from "pages/projects.slint";
export { FinancesState, FinanceStat, FinanceRow, FinanceSection, FinanceChip, FinanceField } from "pages/finances.slint";
export { HousingState, HousingStat, HousingRow, HousingSection, HousingChip, HousingField } from "pages/housing.slint";
export { HealthState, HealthSetRow, HealthExerciseRow, HealthExerciseDay, HealthStretchRow, HealthRoutine, HealthStageRow, HealthHistoryBar, HealthMetricRow } from "pages/health.slint";
export { InboxState, InboxMailbox, InboxFolder, InboxChoice, InboxListRow, InboxLine, InboxAttachment, InboxMessage, InboxHeader } from "pages/inbox.slint";
export { StorageState, StorageFolderRow, StorageCrumb, StorageFolderCard, StorageFileRow, StorageInspector } from "pages/storage.slint";
export { MusicState, MusicExerciseRow, MusicAttachmentRow, MusicPieceRow, MusicBlockItemRow, MusicBlockRow, MusicBlockPair, MusicBeatCell } from "pages/music.slint";
export { NotebooksState, NotebookEntryRow } from "pages/notebooks.slint";

// One tab of the sub-tab strip under the top bar (one per sub-link of the active item).
export struct SubTab {
    label: string,
    active: bool,
}

export component IdantityShell inherits Window {
    title: "idantity";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 480px;

    // The open route (a concrete path such as "/finances/bills") and its navbar title, set by the Rust shell.
    in-out property <string> route: "/";
    in-out property <string> page-title: "Overview";
    // The sidebar rows (from idantity_nav) and the highlighted one.
    in property <[SidebarItem]> nav-items: [];
    in-out property <int> nav-selected: 0;
    callback nav-activated(int);

    // The sub-tab strip: one tab per sub-link of the active item (idantity_nav::subtabs). Rust fills it.
    in property <[SubTab]> subtabs: [];
    callback subtab-clicked(int);

    // The command palette (Ctrl+K). Rust fills and filters the rows and answers the callbacks.
    in property <bool> palette-open: false;
    in property <[PaletteRow]> palette-rows: [];
    in property <int> palette-highlight: -1;
    in-out property <string> palette-query;
    callback palette-requested();
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-picked(int);
    callback palette-closed();

    // Toasts, newest first. Rust owns the queue and its countdown (rimelight_ui_kit::toast).
    in property <[ToastEntry]> toasts: [];
    callback toast-action(int);
    callback toast-close(int);
    callback toast-exit(int);
    callback toast-paused(int, bool);

    // True on macOS: Cmd+K opens the palette there, Ctrl+K elsewhere (set from Rust).
    in property <bool> mac-keys: false;

    // The floating quick-action button (web FloatingActionsOverlay). Rust answers `fab-picked` with the item id.
    property <bool> fab-open: false;
    callback fab-picked(string);

    // The global quick-create to-do modal (todos QuickTodoController, answered by Rust).
    in property <bool> quick-todo-open: false;
    in property <bool> quick-todo-busy: false;
    in property <string> quick-todo-error: "";
    callback quick-todo-save(string, string, string);
    callback quick-todo-cancel();

    // Copy text to the clipboard through the hidden writer (rimelight_ui's ClipboardWriter). rimelight_ui_kit's
    // wire_clipboard! in src/clipboard.rs calls this as invoke_copy_text.
    public function copy-text(value: string) {
        clipboard.copy-text(value);
    }
    clipboard := ClipboardWriter {}

    // Window keyboard entry point. Ctrl+K (Cmd+K on macOS) opens the palette, even when a control has keyboard focus
    // (capture phase). No shell shortcut runs while the sign-in page covers the shell.
    keys := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
// While the connection-lost overlay blocks the app, every key is taken here, so no shortcut runs underneath.            if (Session.connection-lost) {                return accept;            }
            if (!Session.signed-in) {
                return reject;
            }
            if ((event.modifiers.control || (root.mac-keys && event.modifiers.meta))
                && (event.text == "k" || event.text == "K" || event.text == "\u{000b}")) {
                if (!root.palette-open) {
                    root.palette-requested();
                }
                return accept;
            }
            return reject;
        }
        // Bubble phase: a focused text field takes its own typing (so "?" typed in a field stays there).
        key-pressed(event) => {
            if (!Session.signed-in || root.palette-open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                if (root.fab-open) {
                    root.fab-open = false;
                    return accept;
                }
                if (root.quick-todo-open) {
                    root.quick-todo-cancel();
                    return accept;
                }
                return reject;
            }
            if (event.text == "?" && !root.quick-todo-open) {
                shortcuts.open();
                return accept;
            }
            return reject;
        }
    }

    // The keyboard shortcuts list (web: the "?" key), from the shared ShortcutsDialog. Its rows are the shortcuts the
    // idantity shell and its pages answer.
    shortcuts := ShortcutsDialog {
        mac-keys: root.mac-keys;
        host-width: root.width;
        host-height: root.height;
        title: "Keyboard shortcuts";
        description: "";
        sections: [
            {
                title: "Navigation",
                rows: [
                    { label: "Open the command palette", keys: root.mac-keys ? ["Cmd", "K"] : ["Ctrl", "K"], planned: false, has-other: false, other-keys: [] },
                    { label: "Show this list", keys: ["?"], planned: false, has-other: false, other-keys: [] },
                ],
            },
            {
                title: "Editing",
                rows: [
                    { label: "Close the open menu, dialog or quick-add form", keys: ["Escape"], planned: false, has-other: false, other-keys: [] },
                    { label: "Notebook threads: save the entry being typed", keys: ["Enter"], planned: false, has-other: false, other-keys: [] },
                    { label: "Notebook threads: new line in the entry", keys: ["Shift", "Enter"], planned: false, has-other: false, other-keys: [] },
                ],
            },
        ];
    }

    HorizontalLayout {
        Sidebar {
            title: "idantity";
            items: root.nav-items;
            selected <=> root.nav-selected;
            show-collapse: false;
            activated(index) => {
                root.nav-activated(index);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // The top bar: the page title, and the account button at the right (opens the account menu).
            if Session.signed-in : Rectangle {
                height: 48px;
                background: Tokens.surface-base;

                title-text := Text {
                    x: Tokens.space-4;
                    y: (parent.height - self.height) / 2;
                    text: root.page-title;
                    color: Tokens.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                }

                account := Popover {
                    x: parent.width - Tokens.space-4 - 96px;
                    y: 0px;
                    accessible-name: "Account";
                    anchor-height: 48px;
                    panel-width: 200px;
                    align-end: true;
                    Button {
                        width: 100%;
                        text: "Sign out";
                        variant: ButtonVariant.ghost;
                        size: ButtonSize.md;
                        clicked => {
                            account.close();
                            Session.sign-out();
                        }
                    }
                }

                shortcuts-btn := Button {
                    x: parent.width - Tokens.space-4 - 96px - 8px - 96px;
                    y: (parent.height - self.height) / 2;
                    width: 96px;
                    text: "Shortcuts";
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.sm;
                    clicked => {
                        shortcuts.open();
                    }
                }

                account-btn := Button {
                    x: parent.width - Tokens.space-4 - 96px;
                    y: (parent.height - self.height) / 2;
                    width: 96px;
                    text: "Account";
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.sm;
                    accessible-name: "Account";
                    clicked => {
                        account.trigger-clicked();
                    }
                }
            }

            // The sub-tab strip: 44 px, one tab per sub-link of the active item.
            if Session.signed-in && root.subtabs.length > 0 : Rectangle {
                height: 44px;
                background: Tokens.surface-base;

                ScrollView {
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    content-width: strip.preferred-width;

                    strip := HorizontalLayout {
                        height: parent.height;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 20px;
                        alignment: start;

                        for tab[index] in root.subtabs : Rectangle {
                            width: tab-label.preferred-width;
                            height: parent.height;

                            tab-label := Text {
                                x: 0px;
                                y: 14px;
                                height: 16px;
                                text: tab.label;
                                color: tab.active ? Tokens.text-primary : Tokens.text-muted;
                                font-size: 13.5px;
                                font-weight: tab.active ? 600 : 500;
                                wrap: no-wrap;
                            }
                            Rectangle {
                                x: 0px;
                                y: 33px;
                                width: parent.width;
                                height: 2px;
                                background: tab.active ? Tokens.accent-default : transparent;
                            }
                            TouchArea {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                accessible-role: button;
                                accessible-label: tab.label;
                                clicked => { root.subtab-clicked(index); }
                            }
                        }
                    }
                }
            }

            if Session.signed-in && root.route == "/" : OverviewRoute {}
            if Session.signed-in && root.route == "/todos" : TodosRoute {}
            if Session.signed-in && root.route == "/notes" : NotesRoute {}
            if Session.signed-in && root.route == "/habits" : HabitsRoute {}
            if Session.signed-in && (root.route == "/watchlist" || root.route == "/watchlist/movies" || root.route == "/watchlist/series" || root.route == "/watchlist/books") : WatchlistRoute {}
            if Session.signed-in && root.route == "/inbox" : InboxRoute {}
            if Session.signed-in && root.route == "/projects" : ProjectsRoute {}
            if Session.signed-in && (root.route == "/finances" || root.route == "/finances/transactions" || root.route == "/finances/accounts" || root.route == "/finances/incomes" || root.route == "/finances/bills" || root.route == "/finances/budgets" || root.route == "/finances/debts" || root.route == "/finances/wishlist") : FinancesRoute {}
            if Session.signed-in && (root.route == "/housing" || root.route == "/housing/pets" || root.route == "/housing/groceries" || root.route == "/housing/wishlist") : HousingRoute {}
            if Session.signed-in && (root.route == "/health" || root.route == "/health/fasting" || root.route == "/health/workouts" || root.route == "/health/measurements") : HealthRoute {}
            if Session.signed-in && root.route == "/storage" : StorageRoute {}
            if Session.signed-in && (root.route == "/music" || root.route == "/music/piano" || root.route == "/music/guitar" || root.route == "/music/dj") : MusicRoute {}
            if Session.signed-in && root.route == "/notebooks" : NotebooksRoute {}
        }
    }

    // The Focus timer card, drawn over the page at the top right (egui anchored it there).
    if FocusState.open && Session.signed-in : Rectangle {
        x: root.width - 320px - Tokens.space-6;
        y: 64px;
        width: 320px;
        FocusRoute {}
    }

    // The command palette, drawn over the whole window while open.
    palette := CommandPalette {
        visible: root.palette-open;
        width: 100%;
        height: 100%;
        // Rows carry a subtitle and a category, so each is two lines tall.
        row-height: 52px;
        rows: root.palette-rows;
        highlight: root.palette-highlight;
        query <=> root.palette-query;
        query-changed(value) => { root.palette-query-changed(value); }
        move(delta) => { root.palette-move(delta); }
        picked(index) => { root.palette-picked(index); }
        closed => { root.palette-closed(); }
    }
    changed palette-open => {
        if (root.palette-open) {
            palette.focus-me();
        }
    }

    // The floating quick-action button, bottom-right (web FloatingActionsOverlay). Signed in only.
    if Session.signed-in : Button {
        x: root.width - 72px;
        y: root.height - 72px;
        width: 56px;
        height: 56px;
        text: "+";
        variant: ButtonVariant.primary;
        size: ButtonSize.lg;
        accessible-name: "Quick actions";
        clicked => {
            root.fab-open = !root.fab-open;
        }
    }

    // The quick-action menu, above the button.
    if Session.signed-in && root.fab-open : VerticalLayout {
        x: root.width - 232px;
        y: root.height - 80px - self.preferred-height;
        width: 208px;
        padding: Tokens.space-2;
        spacing: 2px;
        Text {
            text: "Quick Actions";
            color: Tokens.text-muted;
            font-size: 11px;
            font-weight: 700;
        }
        for item in [
            { id: "note", label: "New Note" },
            { id: "notebook", label: "New Notebook" },
            { id: "todo", label: "New To-do" },
            { id: "focus", label: "Focus Timer" },
            { id: "transaction", label: "New Transaction" },
            { id: "income", label: "New Income" },
            { id: "bill", label: "New Bill" },
            { id: "wishlist", label: "New Wishlist Item" },
            { id: "account", label: "New Account" },
            { id: "watchlist", label: "New Watchlist Item" },
            { id: "metronome", label: "Metronome" },
        ] : Button {
            width: 100%;
            text: item.label;
            variant: ButtonVariant.ghost;
            size: ButtonSize.sm;
            clicked => {
                root.fab-open = false;
                root.fab-picked(item.id);
            }
        }
    }

    // The quick-add to-do modal, centred over the window (web's global quick to-do modal).
    if Session.signed-in && root.quick-todo-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Tokens.scrim;
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => {
                root.quick-todo-cancel();
            }
        }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: 96px;
            width: min(440px, root.width - 32px);
            height: quick-card.preferred-height + 2 * Tokens.space-4;
            background: Tokens.surface-base;
            border-radius: Tokens.radius-surface;
            quick-card := VerticalLayout {
                x: Tokens.space-4;
                y: Tokens.space-4;
                width: parent.width - 2 * Tokens.space-4;
                spacing: Tokens.space-2;
                QuickTodoModal {
                    open: root.quick-todo-open;
                    busy: root.quick-todo-busy;
                    error: root.quick-todo-error;
                    save-requested(title, category, priority) => {
                        root.quick-todo-save(title, category, priority);
                    }
                    cancel-requested => {
                        root.quick-todo-cancel();
                    }
                }
            }
        }
    }

    // Toasts sit bottom-right of the whole window.
    ToastStack {
        x: root.width - self.width - Tokens.space-4;
        // Above the quick-action button (56px at 16px from the bottom, with a gap), so the two do not overlap.
        y: root.height - self.height - 88px;
        host-width: root.width;
        toasts: root.toasts;
        action-clicked(id) => { root.toast-action(id); }
        close-requested(id) => { root.toast-close(id); }
        exit-done(id) => { root.toast-exit(id); }
        paused-changed(id, paused) => { root.toast-paused(id, paused); }
    }

    // Sign-in screen (the same SignInScreen as Rimelight Space): the last children, so it covers the whole window, sidebar
    // included, until there is a session. Its pointer area takes every click while it is shown. Loading, signed out, waiting
    // for the browser and "Can't reach idantity" are phases of the one component.
    sign-in := SignInScreen {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        visible: Session.phase != SessionPhase.signed-in;
        phase: Session.phase;
        error-text: Session.error;
        product-name: "idantity";
        sign-in-label: "Sign in";
        sign-in-clicked => { Session.sign-in(); }
        cancel-clicked => { Session.cancel(); }
        retry-clicked => { Session.retry(); }
    }

    // Connection lost (as Rimelight Space, SA.9): while signed in and the server cannot be reached, one full-window overlay
    // blocks the whole app. The scrim takes every pointer press and its focus scope takes every key, so nothing underneath
    // can send a request. The open page stays underneath and reappears unchanged when the connection returns.
    lost-overlay := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        visible: Session.connection-lost;
        background: Tokens.scrim;

        // Swallows every pointer press, move and wheel over the window.
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }

        // Takes the keyboard while shown and accepts every key.
        lost-keys := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            key-pressed(event) => { return accept; }
            key-released(event) => { return accept; }
        }

        Rectangle {
            width: min(parent.width - Tokens.space-8, 360px);
            height: lost-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.surface-raised;
            border-radius: Tokens.radius-r4;
            border-width: 1px;
            border-color: Tokens.border-subtle;

            lost-layout := VerticalLayout {
                padding: Tokens.space-6;
                spacing: Tokens.space-4;
                alignment: center;

                Spinner { size: SpinnerSize.md; }

                Text {
                    text: "Connection lost";
                    color: Tokens.text-primary;
                    font-family: Type.title.family;
                    font-size: Type.title.size;
                    font-weight: Type.title.weight;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Connection lost";
                }

                Text {
                    text: "Reconnecting…";
                    color: Tokens.text-muted;
                    font-family: Type.body.family;
                    font-size: Type.body.size;
                    font-weight: Type.body.weight;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Reconnecting…";
                    accessible-live-region: polite;
                }
            }
        }

        changed visible => {
            if (self.visible) {
                lost-keys.focus();
            }
        }
    }
}
