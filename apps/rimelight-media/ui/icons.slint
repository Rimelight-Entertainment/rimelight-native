// Media-only icons. The Lucide icons the Rimelight apps share are in @rimelight_ui/icons.slint (Icons), imported as
// SharedIcons where the same icon is used.
// Icons are monochrome: tint them with `colorize`.
export global Icons {
    out property <image> logo: @image-url("../assets/icons/logo-color.svg");
    // The app's own icon (the .exe and shortcut icon), as a PNG exported from assets/rimelight-media.ico.
    out property <image> app-icon: @image-url("../assets/rimelight-media.png");
    out property <image> folder-search: @image-url("../assets/icons/folder-search.svg");
    out property <image> folder-plus: @image-url("../assets/icons/folder-plus.svg");
    out property <image> cloud: @image-url("../assets/icons/cloud.svg");
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> skip-forward: @image-url("../assets/icons/skip-forward.svg");
    out property <image> highlighter: @image-url("../assets/icons/highlighter.svg");
    out property <image> record: @image-url("../assets/icons/record.svg");
    out property <image> crop: @image-url("../assets/icons/crop.svg");
    out property <image> scissors: @image-url("../assets/icons/scissors.svg");
    out property <image> subtitles: @image-url("../assets/icons/subtitles.svg");
    out property <image> music: @image-url("../assets/icons/music.svg");
    out property <image> save: @image-url("../assets/icons/save.svg");
    out property <image> camera: @image-url("../assets/icons/camera.svg");
    out property <image> resize: @image-url("../assets/icons/resize.svg");
    out property <image> audio-lines: @image-url("../assets/icons/audio-lines.svg");
    out property <image> stop: @image-url("../assets/icons/square-stop.svg");
    out property <image> printer: @image-url("../assets/icons/printer.svg");
    out property <image> film: @image-url("../assets/icons/film.svg");
    out property <image> fit: @image-url("../assets/icons/fit.svg");
    out property <image> fullscreen: @image-url("../assets/icons/fullscreen.svg");
    out property <image> dims: @image-url("../assets/icons/ruler.svg");
    out property <image> lasso: @image-url("../assets/icons/lasso.svg");
    out property <image> text-scan: @image-url("../assets/icons/text-scan.svg");
    out property <image> cast: @image-url("../assets/icons/cast.svg");
    out property <image> text-wrap: @image-url("../assets/icons/text-wrap.svg");
    out property <image> align-left: @image-url("../assets/icons/align-left.svg");
    out property <image> minimize: @image-url("../assets/icons/minimize-2.svg");
    out property <image> sort-az: @image-url("../assets/icons/arrow-down-a-z.svg");
    out property <image> brush: @image-url("../assets/icons/brush.svg");
    out property <image> paint-bucket: @image-url("../assets/icons/paint-bucket.svg");
    out property <image> select-rect: @image-url("../assets/icons/square-dashed.svg");
    out property <image> move: @image-url("../assets/icons/move.svg");
    out property <image> file-plus: @image-url("../assets/icons/file-plus.svg");
    out property <image> save-as: @image-url("../assets/icons/save-as.svg");
    out property <image> md-editor: @image-url("../assets/icons/md-editor.svg");
    out property <image> chevron-up: @image-url("../assets/icons/chevron-up.svg");
    out property <image> file-code: @image-url("../assets/icons/file-code.svg");
    out property <image> list-tree: @image-url("../assets/icons/list-tree.svg");
    out property <image> indent-increase: @image-url("../assets/icons/indent-increase.svg");
    out property <image> list-indent: @image-url("../assets/icons/list-indent.svg");
    out property <image> grid: @image-url("../assets/icons/grid-3x3.svg");
}
