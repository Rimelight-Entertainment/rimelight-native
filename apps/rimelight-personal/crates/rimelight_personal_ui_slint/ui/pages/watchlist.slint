// The Watchlist route (/watchlist, /watchlist/movies, /watchlist/series, /watchlist/books and the archive). The feature
// page (WatchlistPage) owns the markup; this file mirrors its properties and callbacks in WatchlistState.
import { WatchlistPage, WatchlistCategory, WatchlistColumn } from "@rimelight_personal_feature_watchlist/watchlist.slint";
import { SelectOption } from "@rimelight_ui/components/select.slint";
import { TableColumn, TableRow } from "@rimelight_ui/components/table.slint";
import { PageLoadState } from "@rimelight_ui/components/page-state.slint";

export { WatchlistCategory, WatchlistColumn } from "@rimelight_personal_feature_watchlist/watchlist.slint";

export global WatchlistState {
    in property <[TableRow]> rows;
    in property <[TableColumn]> columns;
    in property <PageLoadState> load-state: PageLoadState.loaded;
    in property <int> selected-count: 0;
    in property <int> sort-column: -1;
    in property <bool> sort-descending: false;
    in property <string> section;
    in property <bool> archived;
    in property <string> heading;
    in property <string> count-label;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <string> error;
    in property <string> categories-label;
    in property <bool> category-open;
    in property <string> category-title;
    in property <string> categories-count-label;
    in property <[WatchlistCategory]> category-rows;
    in property <bool> confirm-open;
    in property <bool> form-open;
    in property <bool> form-editing;
    in property <string> form-title;
    in property <string> form-description;
    in property <bool> form-busy;
    in property <[SelectOption]> form-category-options;
    in property <bool> form-no-category-hint;
    in property <bool> form-can-save;
    in property <string> form-save-label;
    in property <[SelectOption]> section-options;
    in property <[SelectOption]> status-options;
    in property <[SelectOption]> form-status-options;
    in property <[WatchlistColumn]> column-chips;
    in-out property <string> search;
    in-out property <string> new-category;
    in-out property <string> form-section;
    in-out property <string> form-category;
    in-out property <string> draft-title;
    in-out property <string> draft-creator;
    in-out property <string> draft-genre;
    in-out property <string> draft-duration;
    in-out property <string> draft-year;
    in-out property <string> draft-rating;
    in-out property <string> draft-status;
    in-out property <string> draft-seasons;
    in-out property <string> draft-episodes;
    in-out property <string> draft-pages;
    in-out property <string> draft-notes;
    in-out property <string> draft-recommended-by;

    callback new-requested();
    callback archive-requested();
    callback categories-requested();
    callback search-changed(string);
    callback export-requested();
    callback dismiss-error-requested();
    callback sort-requested(int);
    callback column-toggle-requested(int);
    callback pick-requested(int, bool, bool);
    callback bulk-complete-requested();
    callback edit-selected-requested();
    callback delete-selected-requested();
    callback status-requested(string, string, string);
    callback edit-requested(string, string);
    callback delete-requested(string, string);
    callback category-add-requested(string);
    callback category-delete-requested(string);
    callback category-closed();
    callback confirm-answered(bool);
    callback form-section-requested(string);
    callback form-category-requested(string);
    callback form-submit-requested();
    callback form-closed();
}

export component WatchlistRoute inherits VerticalLayout {
    WatchlistPage {
        rows: WatchlistState.rows;
        columns: WatchlistState.columns;
        load-state: WatchlistState.load-state;
        selected-count: WatchlistState.selected-count;
        sort-column: WatchlistState.sort-column;
        sort-descending: WatchlistState.sort-descending;
        section: WatchlistState.section;
        archived: WatchlistState.archived;
        heading: WatchlistState.heading;
        count-label: WatchlistState.count-label;
        empty-title: WatchlistState.empty-title;
        empty-text: WatchlistState.empty-text;
        error: WatchlistState.error;
        categories-label: WatchlistState.categories-label;
        category-open: WatchlistState.category-open;
        category-title: WatchlistState.category-title;
        categories-count-label: WatchlistState.categories-count-label;
        category-rows: WatchlistState.category-rows;
        confirm-open: WatchlistState.confirm-open;
        form-open: WatchlistState.form-open;
        form-editing: WatchlistState.form-editing;
        form-title: WatchlistState.form-title;
        form-description: WatchlistState.form-description;
        form-busy: WatchlistState.form-busy;
        form-category-options: WatchlistState.form-category-options;
        form-no-category-hint: WatchlistState.form-no-category-hint;
        form-can-save: WatchlistState.form-can-save;
        form-save-label: WatchlistState.form-save-label;
        section-options: WatchlistState.section-options;
        status-options: WatchlistState.status-options;
        form-status-options: WatchlistState.form-status-options;
        column-chips: WatchlistState.column-chips;
        search <=> WatchlistState.search;
        new-category <=> WatchlistState.new-category;
        form-section <=> WatchlistState.form-section;
        form-category <=> WatchlistState.form-category;
        draft-title <=> WatchlistState.draft-title;
        draft-creator <=> WatchlistState.draft-creator;
        draft-genre <=> WatchlistState.draft-genre;
        draft-duration <=> WatchlistState.draft-duration;
        draft-year <=> WatchlistState.draft-year;
        draft-rating <=> WatchlistState.draft-rating;
        draft-status <=> WatchlistState.draft-status;
        draft-seasons <=> WatchlistState.draft-seasons;
        draft-episodes <=> WatchlistState.draft-episodes;
        draft-pages <=> WatchlistState.draft-pages;
        draft-notes <=> WatchlistState.draft-notes;
        draft-recommended-by <=> WatchlistState.draft-recommended-by;

        new-requested => { WatchlistState.new-requested(); }
        archive-requested => { WatchlistState.archive-requested(); }
        categories-requested => { WatchlistState.categories-requested(); }
        search-changed(text) => { WatchlistState.search-changed(text); }
        export-requested => { WatchlistState.export-requested(); }
        dismiss-error-requested => { WatchlistState.dismiss-error-requested(); }
        sort-requested(column) => { WatchlistState.sort-requested(column); }
        column-toggle-requested(index) => { WatchlistState.column-toggle-requested(index); }
        pick-requested(index, shift, ctrl) => { WatchlistState.pick-requested(index, shift, ctrl); }
        bulk-complete-requested => { WatchlistState.bulk-complete-requested(); }
        edit-selected-requested => { WatchlistState.edit-selected-requested(); }
        delete-selected-requested => { WatchlistState.delete-selected-requested(); }
        status-requested(cat, item, status) => { WatchlistState.status-requested(cat, item, status); }
        edit-requested(cat, item) => { WatchlistState.edit-requested(cat, item); }
        delete-requested(cat, item) => { WatchlistState.delete-requested(cat, item); }
        category-add-requested(name) => { WatchlistState.category-add-requested(name); }
        category-delete-requested(id) => { WatchlistState.category-delete-requested(id); }
        category-closed => { WatchlistState.category-closed(); }
        confirm-answered(answer) => { WatchlistState.confirm-answered(answer); }
        form-section-requested(key) => { WatchlistState.form-section-requested(key); }
        form-category-requested(id) => { WatchlistState.form-category-requested(id); }
        form-submit-requested => { WatchlistState.form-submit-requested(); }
        form-closed => { WatchlistState.form-closed(); }
    }
}
