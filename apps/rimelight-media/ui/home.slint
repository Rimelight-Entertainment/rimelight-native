// Home: the same layout as the empty tabs (toolbar, the shared EmptyState with Open a file and Recent, status bar).
import { Tokens } from "@rimelight_design/tokens.slint";
import { Icons } from "icons.slint";
import { StatusBar, EmptyState } from "widgets.slint";
import { ToolbarRow } from "@rimelight_ui/components/toolbar.slint";
import { Shell } from "state.slint";

export component HomePage inherits Rectangle {
    background: Tokens.surface-base;

    VerticalLayout {
        // The second toolbar row every other tab has (empty here), so the Recent list sits at the same height on all pages.
        ToolbarRow { }
        EmptyState {
            vertical-stretch: 1;
            icon: Icons.app-icon;
            icon-full-colour: true;
            title: "Open a file";
            hint: "Drag and drop an image, audio, video, or text file to open it, or select below.";
            recents: Shell.recents;
            open => { Shell.open-file(); }
            open-recent(i) => { Shell.open-recent(i); }
            clear-recents => { Shell.clear-recents(""); }
        }
        // The same empty bar as the other tabs, so every page ends the same way.
        StatusBar { }
    }
}
