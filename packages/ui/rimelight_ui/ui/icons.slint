    public pure function icon-for(name: string) -> image {
        if (name == "activity") { return activity; }
        if (name == "app-window") { return app-window; }
        if (name == "arrow-down") { return arrow-down; }
        if (name == "arrow-left") { return arrow-left; }
        if (name == "arrow-left-right") { return arrow-left-right; }
        if (name == "arrow-right") { return arrow-right; }
        if (name == "arrow-up") { return arrow-up; }
        if (name == "at-sign") { return at-sign; }
        if (name == "ban") { return ban; }
        if (name == "banknote") { return banknote; }
        if (name == "bell") { return bell; }
        if (name == "book-marked") { return book-marked; }
        if (name == "book-open") { return book-open; }
        if (name == "book-user") { return book-user; }
        if (name == "bookmark") { return bookmark; }
        if (name == "bot") { return bot; }
        if (name == "box") { return box; }
        if (name == "boxes") { return boxes; }
        if (name == "briefcase") { return briefcase; }
        if (name == "briefcase-business") { return briefcase-business; }
        if (name == "bring-to-front") { return bring-to-front; }
        if (name == "bug") { return bug; }
        if (name == "building") { return building; }
        if (name == "building-2") { return building-2; }
        if (name == "calendar") { return calendar; }
        if (name == "calendar-check") { return calendar-check; }
        if (name == "calendar-days") { return calendar-days; }
        if (name == "calendar-plus") { return calendar-plus; }
        if (name == "calendar-range") { return calendar-range; }
        if (name == "chart-column") { return chart-column; }
        if (name == "chart-pie") { return chart-pie; }
        if (name == "check") { return check; }
        if (name == "chevron-down") { return chevron-down; }
        if (name == "chevron-left") { return chevron-left; }
        if (name == "chevron-right") { return chevron-right; }
        if (name == "chevrons-up-down") { return chevrons-up-down; }
        if (name == "circle") { return circle; }
        if (name == "circle-check") { return circle-check; }
        if (name == "circle-dot") { return circle-dot; }
        if (name == "circle-question-mark") { return circle-question-mark; }
        if (name == "circle-x") { return circle-x; }
        if (name == "clipboard-check") { return clipboard-check; }
        if (name == "clipboard-list") { return clipboard-list; }
        if (name == "clock") { return clock; }
        if (name == "columns-2") { return columns-2; }
        if (name == "compass") { return compass; }
        if (name == "concierge-bell") { return concierge-bell; }
        if (name == "contact") { return contact; }
        if (name == "copy") { return copy; }
        if (name == "copy-plus") { return copy-plus; }
        if (name == "credit-card") { return credit-card; }
        if (name == "database") { return database; }
        if (name == "diamond") { return diamond; }
        if (name == "door-open") { return door-open; }
        if (name == "ellipsis") { return ellipsis; }
        if (name == "eraser") { return eraser; }
