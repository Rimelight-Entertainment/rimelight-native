// The Projects route: the feature's ProjectsPage fed by ProjectsState, which the Rust glue (src/pages/projects.rs) fills.
import { ProjectsPage, ProjectBoardTab } from "@idantity_feature_projects/projects.slint";
import { BoardLane, BoardItem } from "@rimelight_shell/templates/board-page.slint";

export { ProjectBoardTab } from "@idantity_feature_projects/projects.slint";
export { BoardLane, BoardItem } from "@rimelight_shell/templates/board-page.slint";

export global ProjectsState {
    in-out property <[ProjectBoardTab]> boards;
    in-out property <bool> has-active-board;
    in-out property <[BoardLane]> lanes;
    in-out property <int> adding-lane: -1;
    in-out property <bool> loading;
    in-out property <string> error;
    in-out property <string> new-board-title;
    in-out property <string> new-list-title;
    in-out property <string> card-title;
    in-out property <string> picked-key;

    callback refresh-requested();
    callback select-board-requested(string);
    callback create-board-requested();
    callback create-list-requested();
    callback start-card-requested(int);
    callback cancel-card-requested();
    callback submit-card-requested();
    callback move-card-requested(string, int);
    callback delete-card-requested(string);
    callback dismiss-error-requested();
    callback column-at(float, float, float, int) -> int;
}

export component ProjectsRoute inherits Rectangle {
    ProjectsPage {
        boards: ProjectsState.boards;
        has-active-board: ProjectsState.has-active-board;
        lanes: ProjectsState.lanes;
        adding-lane: ProjectsState.adding-lane;
        loading: ProjectsState.loading;
        error: ProjectsState.error;
        new-board-title <=> ProjectsState.new-board-title;
        new-list-title <=> ProjectsState.new-list-title;
        card-title <=> ProjectsState.card-title;
        picked-key <=> ProjectsState.picked-key;

        refresh-requested() => { ProjectsState.refresh-requested(); }
        select-board-requested(id) => { ProjectsState.select-board-requested(id); }
        create-board-requested() => { ProjectsState.create-board-requested(); }
        create-list-requested() => { ProjectsState.create-list-requested(); }
        start-card-requested(lane) => { ProjectsState.start-card-requested(lane); }
        cancel-card-requested() => { ProjectsState.cancel-card-requested(); }
        submit-card-requested() => { ProjectsState.submit-card-requested(); }
        move-card-requested(card, lane) => { ProjectsState.move-card-requested(card, lane); }
        delete-card-requested(id) => { ProjectsState.delete-card-requested(id); }
        dismiss-error-requested() => { ProjectsState.dismiss-error-requested(); }
        column-at(x, width, gap, count) => { return ProjectsState.column-at(x, width, gap, count); }
    }
}
